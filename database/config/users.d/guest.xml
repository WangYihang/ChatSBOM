<clickhouse>
    <!--
      The guest account is what `db query`, `db status`, `db export` and the
      AI chat connect as, and is the account any public-facing deployment
      would expose. `readonly` alone bounds what it can *change*, not what it
      can *cost*: one cartesian join can exhaust the server. The profile
      below bounds cost as well.
    -->
    <profiles>
        <guest_readonly>
            <readonly>1</readonly>

            <!-- Cost ceilings: a runaway query fails instead of the server. -->
            <max_execution_time>30</max_execution_time>
            <max_memory_usage>4000000000</max_memory_usage>
            <max_memory_usage_for_user>8000000000</max_memory_usage_for_user>
            <max_bytes_before_external_group_by>2000000000</max_bytes_before_external_group_by>
            <max_rows_to_read>2000000000</max_rows_to_read>
            <max_bytes_to_read>20000000000</max_bytes_to_read>
            <max_result_rows>100000</max_result_rows>
            <max_result_bytes>200000000</max_result_bytes>
            <result_overflow_mode>break</result_overflow_mode>
            <timeout_overflow_mode>throw</timeout_overflow_mode>
            <read_overflow_mode>throw</read_overflow_mode>

            <!-- Bound concurrent load from a single account. -->
            <max_concurrent_queries_for_user>16</max_concurrent_queries_for_user>
            <max_threads>8</max_threads>
            <max_network_bandwidth_for_user>0</max_network_bandwidth_for_user>

            <!-- No writing to disk, no reading from it. -->
            <allow_ddl>0</allow_ddl>
            <allow_introspection_functions>0</allow_introspection_functions>
        </guest_readonly>
    </profiles>

    <users>
        <guest>
            <!--
              Development default. For any deployment reachable from outside
              localhost, replace this with password_sha256_hex and supply the
              value from the environment; see README "Development".
            -->
            <password>guest</password>
            <profile>guest_readonly</profile>
            <allow_databases>
                <database>chatsbom</database>
            </allow_databases>
        </guest>
    </users>
</clickhouse>
