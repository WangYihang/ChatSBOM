[Unit]
Description=ChatSBOM revalidation slice (%f)
Documentation=https://github.com/WangYihang/ChatSBOM
# Collection needs the network; a slice that cannot reach GitHub is a
# wasted wake-up, not a failure worth alerting on.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A template, whose instance is the checkout: `systemd-escape --path` of
# its directory, which %f turns back into the path. So nothing here
# names a checkout, and the units work wherever it is; DEPLOY.md has the
# commands.
WorkingDirectory=%f
# The same `.env` the CLI finds from its working directory, which is the
# checkout. Read by both, the unit's copy wins, since the CLI never
# replaces a variable already set. `-`: a checkout without one is not an
# error, and the CLI runs on its defaults.
EnvironmentFile=-%f/.env

# Each ReadWritePaths= directory below must exist when the sandbox is
# built, or the unit fails before it starts (226/NAMESPACE), and nothing
# inside the sandbox could make it. `.requests-cache` appears on first
# use, so a fresh checkout has none. `+` runs this outside the sandbox.
ExecStartPre=+/bin/mkdir -p %f/data %f/.cache %f/.requests-cache

# flock, not a systemd lock: the same guard then applies when the command
# is run by hand, which is how it will actually be debugged. The lock
# sits beside the ledger it guards, since flock creates the file: in
# $XDG_RUNTIME_DIR, where it was, it could not, as ProtectHome= makes
# /run/user read-only along with /home.
#
# The checkout's own chatsbom, from the .venv `uv sync` makes. Not `uv
# run`: that writes its cache under ~/.cache before anything else, and
# under ProtectHome=read-only it exits 2 without starting chatsbom.
ExecStart=/usr/bin/flock --nonblock %f/data/.sync.lock \
    %f/.venv/bin/chatsbom queue sync --slice 500 --quota 250

# A slice is bounded by design; if it has not finished in ten minutes
# something is wrong and the next timer tick is the better recovery.
TimeoutStartSec=600

# The process only ever reads the repo and writes under data/ and the two
# caches: .cache/, and .requests-cache/, where the HTTP cache is opened
# before the first request.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%f/data %f/.cache %f/.requests-cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=2G

[Install]
WantedBy=default.target
