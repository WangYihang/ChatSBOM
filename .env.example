# Settings for chatsbom. Copy this file to `.env` and fill in what you
# use; a copy left as it is changes nothing. `.env` is git-ignored and
# this file is not, so real values belong only in the copy.
#
# Three things read `.env`:
#   - the chatsbom CLI, from its working directory or the nearest parent
#     directory that has one;
#   - docker compose, from beside docker-compose.yaml, for the ${...}
#     settings in that file;
#   - the systemd units in deploy/systemd, through EnvironmentFile=.
# Kept at the root of a checkout, one file serves all three. For the CLI
# and for compose, a variable already set in the environment wins over
# the file.
#
# So it keeps to what all three parse alike: plain KEY=value lines,
# comments on lines of their own (systemd keeps a trailing "# ..." as
# part of the value), and no `export`.
#
# A commented-out setting shows its default, or an example where there
# is none. Uncomment one only to change it: set but empty is not unset,
# and the CLI would take the empty value over the default.


# --- Collection --------------------------------------------------------

# A GitHub token, for every `github` stage, `queue sync` and the compose
# collector. A fine-grained one with read access to public repositories
# is enough: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
# How `github depgraph` and `run` fetch GitHub's dependency graph. Its
# synchronous endpoint closes on 2026-11-13, for a report that is
# generated and then fetched. `auto` asks the endpoint until then, a
# report when that fails, and only reports from that day; `async` asks
# for reports now, at a request or more extra per repository; `sync`
# asks the endpoint alone, and the stage turns itself off on that day;
# `off` turns the stage off now.
# CHATSBOM_DEPGRAPH_API=auto
# More GitHub tokens for the dependency-graph stage, beside GITHUB_TOKEN,
# comma-separated. GitHub meters that stage per token, so each one adds
# a worker paced to DEPGRAPH_RATE, running in parallel. Values are never
# logged; a token GitHub rejects is skipped. Example: ghp_aaa,ghp_bbb
# CHATSBOM_DEPGRAPH_TOKENS=


# --- docker compose ----------------------------------------------------

# Your uid, from `id -u`. The collector, lock and cli containers run as
# it: data/ and .cache/ are bind mounts owned by whoever cloned the repo,
# and as anyone else the ledger is a read-only database. Empty is 1000.
UID=
# Your gid, from `id -g`, for the same reason. Empty is 1000.
GID=


# --- ClickHouse, for the CLI on the host -------------------------------
# The compose services connect by service name, with settings of their
# own; the accounts are what they take from here: both for cli, the
# admin one for the collector, and the guest password for the dashboard.

# The server's host.
# CLICKHOUSE_HOST=localhost
# Its HTTP port.
# CLICKHOUSE_PORT=8123
# The database. Another name also needs its own GRANT for guest, in
# database/config/users.d/guest.xml.
# CLICKHOUSE_DB=chatsbom
# The account that indexes and exports: `db index`, `db edges`,
# `db raw` and `export`.
# CLICKHOUSE_ADMIN_USER=admin
# Its password. The accounts in database/config/users.d are development
# defaults; for a server reachable beyond localhost, change them there
# and set them here.
# CLICKHOUSE_ADMIN_PASSWORD=admin
# The read-only account that `db query`, `chat` and the dashboard use.
# CLICKHOUSE_GUEST_USER=guest
# Its password, which the compose dashboard and cli take from here too.
# CLICKHOUSE_GUEST_PASSWORD=guest


# --- chatsbom chat -----------------------------------------------------

# An Anthropic API key. The compose dashboard's AI answers use it too;
# without one, /api/chat says they are not configured.
# ANTHROPIC_API_KEY=
# Or an Anthropic auth token in its place, for `chat` alone.
# ANTHROPIC_AUTH_TOKEN=
# Where `chat` sends its requests, and so the key or token above. Unset,
# that is Anthropic. Set it only for an Anthropic-compatible endpoint you
# mean to hand that token to — a gateway you run, or another provider's
# Messages API, used with that provider's token and never an Anthropic
# one.
# ANTHROPIC_BASE_URL=https://llm-gateway.example.com
# Show each cost converted too, at this many units of a currency to the
# US dollar. There is no default: a rate written down is soon wrong.
# CHATSBOM_COST_RATE=7.2
# The symbol of that currency.
# CHATSBOM_COST_SYMBOL=¥


# --- github classify ---------------------------------------------------

# A key for the OpenAI-compatible API that classifies repositories.
# OPENAI_API_KEY=
# That API's address, and so where the key goes. Unset, it is OpenAI's,
# https://api.openai.com/v1, asked for gpt-4o-mini; at any other, name
# one of its own models with --model. A local server needs no key at
# all, Ollama's for instance.
# OPENAI_BASE_URL=http://localhost:11434/v1


# --- Logging -----------------------------------------------------------

# How the CLI logs, on stderr: `console` for a person, or `json`, one
# object per line, for whatever collects the logs. The compose collector
# and depgraph services log JSON whatever this says.
# CHATSBOM_LOG_FORMAT=console
# The older switch, kept as an alias for deployments that set it:
# `production` means `json`. Where both are set, CHATSBOM_LOG_FORMAT wins.
# ENV=production


# --- The compose collector (docker compose --profile collect) ----------

# Seconds between revalidation slices.
# SYNC_INTERVAL_SECONDS=900
# Repositories a slice re-checks.
# SYNC_SLICE=500
# Rate-limited requests a slice may spend; a 304 costs none.
# SYNC_QUOTA=250
# Repositories the `chatsbom run` after each slice may advance through
# the stages that slice made due.
# RUN_LIMIT=50
# API requests that `run` may spend. The dependency graph is metered
# apart, and the `depgraph` service collects it, whatever this is.
# RUN_QUOTA=400
# Repositories each pass of the `depgraph` service fetches graphs for.
# DEPGRAPH_LIMIT=200
# Dependency-graph requests an hour, per token. GitHub allows 100 to 200.
# DEPGRAPH_RATE=90
# Seconds the `depgraph` service waits between passes.
# DEPGRAPH_INTERVAL_SECONDS=300
# Slices between index passes, `db raw --apply` then `db index`: 96 of
# 15 minutes is about a day.
# INDEX_EVERY_SLICES=96
# Slices between retention passes: 96 of 15 minutes is about a day.
# PRUNE_EVERY_SLICES=96
# Scans a retention pass keeps per repository, newest first.
# PRUNE_KEEP=2


# --- The compose dashboard (web) ---------------------------------------

# The address its port 8787 is published on: every interface by
# default, the LAN included. 172.17.0.1 is the docker bridge alone on a
# default install; `ip -4 addr show docker0` says for certain.
# WEB_BIND=0.0.0.0
# Turnstile's secret key. Leave it unset until the page sends a token
# (#32): set, it refuses every chat request that comes without one, and
# for now that is every chat request.
# TURNSTILE_SECRET=
# The most the AI answers may spend in a day, in US dollars.
# DAILY_SPEND_CAP_USD=5
# Seconds between the container's checks that the Worker still answers.
# A wedged Worker does not exit, and the restart policy acts only on an
# exit, so the container exits itself after enough failed checks.
# WATCHDOG_INTERVAL_SECONDS=30
# Failed checks in a row that count as wedged.
# WATCHDOG_FAILURES=4
# Seconds one check waits for an answer.
# WATCHDOG_TIMEOUT_SECONDS=20
# Seconds after the start before the first check.
# WATCHDOG_GRACE_SECONDS=60
# Any value turns the checks off, leaving a bare `wrangler dev`.
# WATCHDOG_DISABLED=
