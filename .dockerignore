# The dataset is bind-mounted, never baked into the image.
data/
.cache/
.requests-cache/
.workspaces/
database/data/
web/node_modules/
web/dist/
dist/
figures/
.venv/
.git/
*.csv

# Secrets and build outputs never belong in an image. `COPY web/ ./`
# takes whatever is in web/, so a developer's own `web/.env` sat in a
# layer of the dashboard's image, where anyone holding the image could
# read it.
.env
web/.env
dist/d1/
dist/data/
