{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatsbom",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The SPA is served straight from static assets, so page loads cost
  // no Worker invocations. Only /api/* runs the Worker. A prefix left
  // out of run_worker_first is answered by the SPA fallback instead —
  // an HTML page where the caller expected JSON.
  // Secrets, set with `wrangler secret put`:
  //   ANTHROPIC_API_KEY   required for /api/chat
  //   TURNSTILE_SECRET    optional; when set, every question must first pass
  //                       a Turnstile challenge, which the page shows with
  //                       TURNSTILE_SITE_KEY under vars below (DEPLOY.md)
  //   EDGE_SECRET         optional; when set, CF-Connecting-IP is believed
  //                       only on a request carrying it as X-Edge-Secret
  //                       (src/ratelimit.ts, DEPLOY.md)
  // and one var, unset here: ANTHROPIC_BASE_URL, where model calls go
  // if not to Anthropic — a gateway of your own, or a stand-in in a test.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Per-client throttles, both keyed by src/ratelimit.ts: the address
  // Cloudflare names, or, when EDGE_SECRET is set, one shared bucket for
  // every request the edge did not vouch for. `namespace_id` is a number
  // of your choosing, unique in the account. `wrangler dev` simulates
  // them locally, so a 429 there is the real thing.
  "ratelimits": [
    // The chat: every question is a paid model call.
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    // The query endpoint. A page view is about 25 calls, so this is
    // several a second for a person and a ceiling for a script: every
    // visitor shares one ClickHouse account and its 16 concurrent
    // queries, and on D1 every call is billed reads.
    {
      "name": "QUERY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 100, "period": 10 }
    }
  ],

  // Running total of estimated model spend, so a runaway cannot become a
  // large bill. Create with: wrangler kv namespace create SPEND
  // The dataset as a database, for the /api/q serving model. Create it
  // with `wrangler d1 create chatsbom` and put the returned id here.
  //
  // Both models can be configured at once: /data/* streams Parquet to a
  // browser-side engine, /api/q answers from D1. A deployment that
  // omits this binding answers /api/q with 503 rather than failing.
  "d1_databases": [
    { "binding": "DB", "database_name": "chatsbom", "database_id": "<d1-database-id>" }
  ],

  "kv_namespaces": [
    { "binding": "SPEND", "id": "<kv-namespace-id>" }
  ],

  "vars": {
    "DAILY_SPEND_CAP_USD": "5",
    // Turnstile's site key, from the same widget as TURNSTILE_SECRET.
    // Public — every page that shows the widget carries it — so a var
    // rather than a secret. Empty, with the secret unset, is off.
    "TURNSTILE_SITE_KEY": ""
  },

  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "chatsbom-data",
      "preview_bucket_name": "chatsbom-data-preview"
    }
  ]
}
