{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatsbom",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The SPA is served straight from static assets, so page loads cost no
  // Worker invocations. Only /data/* runs the Worker, to stream Parquet
  // byte ranges out of R2.
  // Secrets, set with `wrangler secret put`:
  //   ANTHROPIC_API_KEY   required for /api/chat
  //   TURNSTILE_SECRET    optional; when set, chat requires a Turnstile token
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/data/*", "/api/*"]
  },

  // Parquet lives in R2 rather than in static assets: assets cap at
  // 25 MiB per file, and R2 serves the ranged reads DuckDB-WASM issues.
  // Per-IP throttle on the chat endpoint. Create the namespace in the
  // dashboard, then put its id here.
  "unsafe": {
    "bindings": [
      {
        "name": "CHAT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  },

  // Running total of estimated model spend, so a runaway cannot become a
  // large bill. Create with: wrangler kv namespace create SPEND
  "kv_namespaces": [
    { "binding": "SPEND", "id": "<kv-namespace-id>" }
  ],

  "vars": {
    "DAILY_SPEND_CAP_USD": "5"
  },

  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "chatsbom-data",
      "preview_bucket_name": "chatsbom-data-preview"
    }
  ]
}
