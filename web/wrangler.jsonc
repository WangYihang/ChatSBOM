{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatsbom",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // What the Worker reads that is not bound below. Secrets, set with
  // `wrangler secret put`:
  //   ANTHROPIC_API_KEY   required for /api/chat
  //   TURNSTILE_SECRET    optional; when set, every question must first pass
  //                       a Turnstile challenge, which the page shows with
  //                       TURNSTILE_SITE_KEY under vars below (DEPLOY.md)
  //   EDGE_SECRET         optional; when set, CF-Connecting-IP is believed
  //                       only on a request carrying it as X-Edge-Secret
  //                       (src/ratelimit.ts, DEPLOY.md)
  //   CLICKHOUSE_PASSWORD CLICKHOUSE_USER's password, `guest` unless set
  // And vars, unset here:
  //   TURNSTILE_HOSTNAMES the site's hostnames, comma-separated: a token
  //                       solved on any other page is refused. Unset,
  //                       the host each request was sent to (src/chat.ts)
  //   ANTHROPIC_BASE_URL  where model calls go if not to Anthropic: a
  //                       gateway of your own, or a stand-in in a test
  //   CLICKHOUSE_URL      set, /api/q answers from that ClickHouse over
  //                       HTTP rather than from D1 (src/d1/api.ts)
  //   CLICKHOUSE_DB       its database, `chatsbom` unless set
  //   CLICKHOUSE_USER     its account, `guest` unless set
  //   GENERATOR           the provenance line the page shows for
  //                       ClickHouse, which cannot know it; D1 has the
  //                       one the export wrote into the data
  // Under compose, deploy/web-entrypoint.sh hands `wrangler dev` the
  // ClickHouse settings, GENERATOR and the secrets.

  // The SPA is served straight from static assets, so page loads cost
  // no Worker invocations. Only /api/* runs the Worker. A prefix left
  // out of run_worker_first is answered by the SPA fallback instead —
  // an HTML page where the caller expected JSON.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Per-client throttles, both keyed by src/ratelimit.ts: the address
  // Cloudflare names, or, when EDGE_SECRET is set, one shared bucket for
  // every request the edge did not vouch for. `namespace_id` is a number
  // of your choosing, unique in the account. `wrangler dev` simulates
  // them locally, so a 429 there is the real thing.
  "ratelimits": [
    // The chat: every question is a paid model call.
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    // The query endpoint. A page view is about 25 calls, so this is
    // several a second for a person and a ceiling for a script: every
    // visitor shares one ClickHouse account and its 16 concurrent
    // queries, and on D1 every call is billed reads.
    {
      "name": "QUERY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 100, "period": 10 }
    }
  ],

  // The dataset as a database: /api/q answers from it when no
  // CLICKHOUSE_URL is set, and from ClickHouse when one is, the D1
  // binding or not (src/d1/api.ts). With neither, /api/q answers 503
  // rather than failing.
  //
  // The id is a placeholder. A deploy needs the real one: create the
  // database with `wrangler d1 create chatsbom` and put the id it
  // returns here (DEPLOY.md, section 2). `wrangler dev --local` takes
  // the placeholder as it is, as the name of a local database, which is
  // how compose runs the Worker: it answers from ClickHouse there.
  "d1_databases": [
    { "binding": "DB", "database_name": "chatsbom", "database_id": "<d1-database-id>" }
  ],

  // The daily spend cap's counter (src/spend.ts, #33): a Durable Object
  // per UTC day, which holds each call's worst case before it is made
  // and settles it at what it cost, and clears itself with an alarm an
  // hour after its day ends (#115). Nothing to create by hand: the
  // migration below creates the class on the first deploy that has it,
  // and `wrangler dev` runs it locally, keeping its state in
  // .wrangler/state — under compose, the web-state volume.
  "durable_objects": {
    "bindings": [{ "name": "SPEND_COUNTER", "class_name": "SpendCounter" }]
  },
  // SQLite-backed: the storage Cloudflare recommends for a new class,
  // and the only kind on the Workers free plan. A migration is applied
  // once, by tag; later changes to classes are new entries after it.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpendCounter"] }],

  "vars": {
    // The most the AI answers may spend in a UTC day, in dollars.
    // Empty or 0 is no cap; anything else that is not a number of
    // dollars refuses every question rather than lifting it.
    "DAILY_SPEND_CAP_USD": "5",
    // Turnstile's site key, from the same widget as TURNSTILE_SECRET.
    // Public — every page that shows the widget carries it — so a var
    // rather than a secret. Empty, with the secret unset, is off.
    "TURNSTILE_SITE_KEY": ""
  }
}
