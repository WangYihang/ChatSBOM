{
    "dependencies": {
        "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@visx/scale": "^4.0.0",
        "altcha": "^3.5.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^30.1.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "name": "chatsbom-web",
    "private": true,
    "scripts": {
        "build": "vite build",
        "dev": "vite dev",
        "lint": "eslint .",
        "schema": "cd .. && uv run chatsbom export schema --typescript web/src/schema.ts --json web/src/schema.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.browser.json && tsc -p tsconfig.test.json",
        "validate:palette": "node --experimental-strip-types scripts/validate-palette.mjs"
    },
    "type": "module"
}
