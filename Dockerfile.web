# The dashboard, so serving it leaves nothing on the host.
#
# Previously this ran as `npx wrangler dev --port 8787` on the host,
# beside a host `cloudflared`. Two things improve by moving it here,
# and one does not — stated plainly, because a container is not a
# security control by itself:
#
#   - ClickHouse no longer needs a host port for the dashboard to reach
#     it. The two talk over the compose network by service name, so the
#     database is reachable only from inside it.
#   - `docker compose down` removes the whole thing: no stray `workerd`
#     surviving a build, which is exactly how the site went down for two
#     hours during development.
#
# What does **not** improve: `wrangler dev` is a development server, and
# putting it in a container does not make it a production one. Running
# it under `workerd serve` would, and is a real change rather than a
# packaging one — `ASSETS` is a binding wrangler synthesises, not
# something workerd provides. Until then the mitigation is that the only
# intended path in is a tunnel, a `cloudflared` outside the project that
# reaches the port compose publishes, and switching off what a
# development server offers and a public one must not: the local
# explorer (below), and secrets on the command line (the entrypoint).
# That is only as good as the published address, and compose publishes
# 8787 on every interface unless WEB_BIND says otherwise.
#
# Pinned by digest, as Dockerfile's images are, for the reason given there.
FROM node:26-slim@sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1

WORKDIR /app/web

# Dependencies first, so a source edit does not reinstall them.
# `npm ci` rather than `install`: the lockfile is the input, and a
# resolved-at-build-time tree would make the image unreproducible — the
# same argument as pinning Syft in Dockerfile. devDependencies included,
# so before NODE_ENV=production and without --omit=dev: the build runs
# vite, and the entrypoint runs wrangler from node_modules/.bin.
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

# Built at image time, not at start. `wrangler dev` serves the *build*
# rather than the sources, so a container that built on boot would
# serve nothing until it finished, and a build failure would surface as
# an empty page rather than a failed image.
RUN npm run build

# The bundle and node_modules belong to the image; nothing here is
# bind-mounted, so an unprivileged fixed uid is right — unlike the
# collector, which writes to host-owned directories.
#
# `.wrangler/state` is made here, before the chown, for the named volume
# compose mounts over it: creating a container, Docker fills an empty
# named volume from the image's directory, ownership included. Were the
# directory missing, the volume would stay as Docker makes it, owned by
# root, and uid 10002 could not write the spend counter the daily cap
# reads.
RUN useradd --create-home --uid 10002 dashboard \
 && mkdir -p /app/web/.wrangler/state \
 && chown -R 10002:10002 /app/web

USER 10002

ENV NODE_ENV=production

# wrangler serves miniflare's local explorer unless told not to: a UI
# and API under /cdn-cgi/local/explorer that read and write every
# binding — the spend counter's storage, raw SQL on D1. miniflare admits a
# /cdn-cgi/ request on its Host header alone, and `Host: localhost` is a
# header anyone who can reach 8787 can send. wrangler reads exactly this
# variable and exactly `true` or `false`; anything else stops it starting.
#
# Local observability goes with it. It records a trace of every Worker
# invocation into `.wrangler/state`, which is now a volume, in a store
# with no retention whose only reader is the explorer: 500 `/api/q`
# calls wrote 4.8 MB that nothing would ever read or clear.
ENV X_LOCAL_EXPLORER=false \
    X_LOCAL_OBSERVABILITY=false

# The entrypoint translates the container environment into Worker
# `--var`s and a `.dev.vars` file, which is not the same thing — see the
# note in it.
COPY deploy/web-entrypoint.sh /usr/local/bin/web-entrypoint.sh

EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/web-entrypoint.sh"]
